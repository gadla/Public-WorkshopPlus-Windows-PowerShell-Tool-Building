<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clock Demo" Width="400" Height="200" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <system:String x:Key="Value_clock"></system:String>
    </Window.Resources>
    <Grid>
        <Label Name="Clock" Content="{DynamicResource Value_clock}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
