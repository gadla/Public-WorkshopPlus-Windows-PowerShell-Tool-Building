<Window x:Class="WPFEvents"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPFEvents" Height="400" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TextBox for path input -->

        <!-- Button to trigger Get-ChildItem -->
        <Button x:Name="ButtonGetChildItem" Grid.Row="0" Grid.Column="0" Margin="10,40,10,10" Content="Populate ListBoxes" Width="120" />

        <!-- ListBox showing files or folders -->
        <ListBox x:Name="ListBoxResults" Grid.Row="1" Grid.Column="0" Margin="10" />

        <!-- ListBox with numbers (to be filled in PowerShell) -->
        <ListBox x:Name="ListBoxNumbers" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="10" />
    </Grid>
</Window>
