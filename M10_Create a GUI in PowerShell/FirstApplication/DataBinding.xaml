<Window x:Class="DirectoryExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DirectoryExplorer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="PathTextBox" HorizontalAlignment="Left" Margin="36,61,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="413"/>
        <Button x:Name="SearchButton" Content="Search" HorizontalAlignment="Left" Margin="36,100,0,0" VerticalAlignment="Top" Height="47" Width="114"/>
        <StackPanel HorizontalAlignment="Left" Orientation="Vertical" VerticalAlignment="Top" Margin="173,109,0,0">
            <RadioButton x:Name="FileRadioButton" Content="Files"/>
            <RadioButton x:Name="DirectoryRadioButton" Content="Directories"/>
  
        </StackPanel>
        <ListBox x:Name="DisplayListBox"  Margin="36,168,541,81"/>
        <Label x:Name="LabelSelected" Content="Selected:" HorizontalAlignment="Left" Margin="293,100,0,0" VerticalAlignment="Top"/>
        <Label x:Name="LabelSelectedFile" Content="{Binding ElementName=DisplayListBox, Path=SelectedItem, Mode=OneWay}" HorizontalAlignment="Left" Margin="293,121,0,0" VerticalAlignment="Top"/>
        <ListView x:Name="DisplayListView"  Margin="298,168,247,81"></ListView>
  
    </Grid>
</Window>

